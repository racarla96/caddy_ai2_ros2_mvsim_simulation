{#- Sensores del Caddy (los activos de robot_params.yaml). Se incluye dentro de <vehicle> en cada mundo. -#}
{% for s in sensors %}
{%- if s.kind == 'imu' %}
        <include file="{{ defs }}/imu.sensor.xml"
            sensor_name="{{ s.mvsim_name }}"
            sensor_x="{{ s.x }}" sensor_y="{{ s.y }}" sensor_z="{{ s.z }}"
            sensor_yaw="{{ s.yaw_deg }}" sensor_pitch="{{ s.pitch_deg }}" sensor_roll="{{ s.roll_deg }}"
            sensor_period_sec="{{ 1.0 / s.update_rate }}"
            sensor_angular_velocity_white_noise_std_noise="{{ s.gyro_stddev }}"
            sensor_linear_acceleration_white_noise_std_noise="{{ s.accel_stddev }}"
            sensor_measure_orientation="{{ 'true' if s.measure_orientation else 'false' }}"
            sensor_custom_visual="false"
        />
{%- elif s.kind == 'gps' %}
        <include file="{{ defs }}/gnss.sensor.xml"
            sensor_name="{{ s.mvsim_name }}"
            sensor_x="{{ s.x }}" sensor_y="{{ s.y }}" sensor_z="{{ s.z }}"
            sensor_period_sec="{{ 1.0 / s.update_rate }}"
            sensor_horizontal_std_noise="{{ s.horizontal_stddev }}"
            sensor_vertical_std_noise="{{ s.vertical_stddev }}"
            sensor_custom_visual="false"
        />
{%- elif s.kind == 'lidar_2d' %}
        <include file="{{ defs }}/lidar2d.sensor.xml"
            sensor_name="{{ s.mvsim_name }}"
            sensor_x="{{ s.x }}" sensor_y="{{ s.y }}" sensor_z="{{ s.z }}" sensor_yaw="{{ s.yaw_deg }}"
            sensor_period_sec="{{ 1.0 / s.update_rate }}"
            fov_degrees="{{ s.fov_degrees }}" sensor_nrays="{{ s.nrays }}"
            sensor_std_noise="{{ s.range_stddev }}"
            max_range="{{ s.range_max }}"
            raytrace_3d="{{ 'true' if s.raytrace_3d else 'false' }}"
            sensor_custom_visual="false"
            viz_visiblePoints="false"
        />
{%- elif s.kind == 'lidar_3d' %}
        <!-- RS-Helios-5515: 32 canales, -55 a +15 grados (angulos reales). Es la definicion helios-32-FOV-70 de
             MVSim con una unica diferencia: ignore_parent_body, que esa definicion no expone. Sin el, el lidar
             ve la carroceria del propio vehiculo (un STL, o por defecto una caja de 0,2 a 1,9 m que lo encierra:
             todos los rayos devuelven 0,6-2 m). Con el, no hace falta el CropBox que si necesita Gazebo. -->
        <sensor class="lidar3d" name="{{ s.mvsim_name }}">
            <pose_3d>{{ s.x }} {{ s.y }} {{ s.z }} {{ s.yaw_deg }} {{ s.pitch_deg }} {{ s.roll_deg }}</pose_3d>
            <ignore_parent_body>true</ignore_parent_body>
            <vert_nrays>32</vert_nrays>
            <vertical_ray_angles>-55.020 -52.081 -49.142 -46.204 -43.265 -40.326 -37.387 -34.449 -31.510 -28.571 -25.632 -22.694 -19.755 -16.816 -13.877 -10.939 -8.000 -6.667 -5.333 -4.000 -2.667 -1.333  0.000 1.333 2.667 4.000 5.333 6.667 8.754 10.841 12.929 15</vertical_ray_angles>
            <sensor_period>$f{1.0/{{ s.update_rate }}}</sensor_period>
            <horz_nrays>$f{(1.0/{{ s.update_rate }})/55.296e-6}</horz_nrays>
            <horz_resolution_factor>1.0</horz_resolution_factor>
            <vert_resolution_factor>1.0</vert_resolution_factor>
            <max_vert_relative_depth_to_interpolate>0.3</max_vert_relative_depth_to_interpolate>
            <max_horz_relative_depth_to_interpolate>0.1</max_horz_relative_depth_to_interpolate>
            <range_std_noise>{{ s.range_stddev }}</range_std_noise>
            <min_range>{{ s.range_min }}</min_range>
            <max_range>{{ s.range_max }}</max_range>
            <visual> <model_uri>{{ defs }}/../models/velodyne-vlp16.dae</model_uri> <model_roll>90</model_roll> </visual>
            <generate_intensity>false</generate_intensity>
            <publish enabled="false">
                <publish_topic>/${PARENT_NAME}/${NAME}</publish_topic>
            </publish>
        </sensor>
{%- elif s.kind == 'camera_rgbd' %}
        <sensor class="rgbd_camera" name="{{ s.mvsim_name }}">
            <pose_3d>{{ s.x }} {{ s.y }} {{ s.z }} {{ s.yaw_deg }} {{ s.pitch_deg }} {{ s.roll_deg }}</pose_3d>
            <!-- el RGB sigue la convencion +Z adelante; la profundidad, +X adelante -->
            <relativePoseIntensityWRTDepth>0.0 0.0 0.0  -90.0 0.0 -90.0</relativePoseIntensityWRTDepth>
            <sensor_period>{{ 1.0 / s.update_rate }}</sensor_period>
            <sense_depth>true</sense_depth>
            <sense_rgb>true</sense_rgb>
            <show_3d_pointcloud>{{ 'true' if s.show_3d_pointcloud else 'false' }}</show_3d_pointcloud>
            <publish_ros_depth_image>true</publish_ros_depth_image>
            <!-- metros en float32 (NaN = invalido), como el rgbd_camera de Gazebo (MVSim >= 2.0) -->
            <ros_depth_image_encoding>32FC1</ros_depth_image_encoding>
            <publish_ros_colored_pointcloud>true</publish_ros_colored_pointcloud>

            <depth_ncols>{{ s.image_width }}</depth_ncols>
            <depth_nrows>{{ s.image_height }}</depth_nrows>
            <depth_cx>{{ s.cx }}</depth_cx> <depth_cy>{{ s.cy }}</depth_cy>
            <depth_fx>{{ s.fx }}</depth_fx> <depth_fy>{{ s.fx }}</depth_fy>
            <depth_resolution>1e-3</depth_resolution>
            <depth_clip_min>{{ s.range_min }}</depth_clip_min>
            <depth_clip_max>{{ s.range_max }}</depth_clip_max>
            <depth_noise_sigma>{{ s.depth_stddev }}</depth_noise_sigma>

            <rgb_ncols>{{ s.image_width }}</rgb_ncols>
            <rgb_nrows>{{ s.image_height }}</rgb_nrows>
            <rgb_cx>{{ s.cx }}</rgb_cx> <rgb_cy>{{ s.cy }}</rgb_cy>
            <rgb_fx>{{ s.fx }}</rgb_fx> <rgb_fy>{{ s.fx }}</rgb_fy>
            <rgb_clip_min>{{ s.range_min }}</rgb_clip_min>
            <rgb_clip_max>{{ s.range_max }}</rgb_clip_max>

            <visual> <model_uri>{{ defs }}/../models/simple_camera.dae</model_uri> <model_pitch>90</model_pitch> </visual>
        </sensor>
{%- endif %}
{% endfor %}
